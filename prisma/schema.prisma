generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum BusinessGoal {
  INCREASE_SALES
  ACQUIRE_CUSTOMERS
  BRAND_AWARENESS
  SOCIAL_MEDIA_GROWTH
  ONLINE_SALES
  LAUNCH_PRODUCT
  AUTOMATE_PROCESSES
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  YOUTUBE
  GOOGLE
  OTHER
}

enum BrandTone {
  PROFESSIONAL
  FRIENDLY
  PREMIUM
  PLAYFUL
  DIRECT
  EDUCATIONAL
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             UserRole         @default(CUSTOMER)
  preferredLocale  String           @default("ka")
  termsAcceptedAt  DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orders           Order[]          @relation("CustomerOrders")
  providerSlug     String?          @unique
  assignedOrders   Order[]          @relation("ProviderOrders")
  providerStatus   ProviderStatus   @default(PENDING)
  subscriptionPlan SubscriptionPlan @default(FREE)
  businessProfile  BusinessProfile?
  aiConversations  AIConversation[]
  aiUsage          AIUsage[]
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIFeature {
  AI_ASSISTANT
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIUsage {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       AIFeature
  periodKey     String
  requestCount  Int       @default(0)
  reservedCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, feature, periodKey])
}

model BusinessProfile {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  industry                 String
  description              String?
  website                  String?
  locationMarket           String?
  productsServices         String?
  primaryOffer             String?
  targetAudience           String?
  audienceLocation         String?
  customerProblem          String?
  goals                    BusinessGoal[]
  brandTone                BrandTone?
  brandToneNotes           String?
  preferredContentLanguage String           @default("ka")
  brandValues              String?
  socialPlatforms          SocialPlatform[]
  competitors              Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerId       String
  customer         User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  providerUserId   String?
  providerUser     User?         @relation("ProviderOrders", fields: [providerUserId], references: [id], onDelete: SetNull)
  serviceId        String
  serviceSlug      String
  serviceTitleKa   String
  serviceTitleEn   String
  providerSlug     String
  providerName     String
  packageId        String
  packageNameKa    String
  packageNameEn    String
  priceMinor       Int
  currency         String        @default("GEL")
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  requirementsText String
  referenceLinks   Json?
  deliveryDate     DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([providerUserId, status])
}
