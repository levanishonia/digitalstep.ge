generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            UserRole @default(CUSTOMER)
  preferredLocale String   @default("ka")
  termsAcceptedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]  @relation("CustomerOrders")
  providerSlug    String?  @unique
  assignedOrders  Order[]  @relation("ProviderOrders")
  providerStatus  ProviderStatus @default(PENDING)
  subscriptionPlan SubscriptionPlan @default(FREE)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerId       String
  customer         User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  providerUserId   String?
  providerUser     User?         @relation("ProviderOrders", fields: [providerUserId], references: [id], onDelete: SetNull)
  serviceId        String
  serviceSlug      String
  serviceTitleKa   String
  serviceTitleEn   String
  providerSlug     String
  providerName     String
  packageId        String
  packageNameKa    String
  packageNameEn    String
  priceMinor       Int
  currency         String        @default("GEL")
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  requirementsText String
  referenceLinks   Json?
  deliveryDate     DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([providerUserId, status])
}
