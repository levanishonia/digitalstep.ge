generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum BusinessGoal {
  INCREASE_SALES
  ACQUIRE_CUSTOMERS
  BRAND_AWARENESS
  SOCIAL_MEDIA_GROWTH
  ONLINE_SALES
  LAUNCH_PRODUCT
  AUTOMATE_PROCESSES
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  YOUTUBE
  GOOGLE
  OTHER
}

enum BrandTone {
  PROFESSIONAL
  FRIENDLY
  PREMIUM
  PLAYFUL
  DIRECT
  EDUCATIONAL
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_IN_PROGRESS
  ORDER_IN_REVIEW
  ORDER_COMPLETED
  ORDER_CANCELLED
  NEW_MESSAGE
  PROVIDER_VERIFIED
  PROVIDER_SUSPENDED
  SERVICE_APPROVED
  SERVICE_REJECTED
  AI_USAGE_NEAR_LIMIT
  AI_USAGE_LIMIT_REACHED
  CONTENT_REMINDER
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  role                  UserRole             @default(CUSTOMER)
  preferredLocale       String               @default("ka")
  termsAcceptedAt       DateTime
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  orders                Order[]              @relation("CustomerOrders")
  providerSlug          String?              @unique
  assignedOrders        Order[]              @relation("ProviderOrders")
  providerStatus        ProviderStatus       @default(PENDING)
  providerProfile       ProviderProfile?
  subscriptionPlan      SubscriptionPlan     @default(FREE)
  businessProfile       BusinessProfile?
  aiConversations       AIConversation[]
  aiUsage               AIUsage[]
  aiReservations        AIUsageReservation[]
  aiGenerations         AIGeneration[]
  contentItems          ContentItem[]
  customerConversations Conversation[]       @relation("ConversationCustomer")
  providerConversations Conversation[]       @relation("ConversationProvider")
  sentMessages          Message[]            @relation("MessageSender")
  notifications         Notification[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json?
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ProviderProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String   @unique
  displayName      String
  headline         String?
  description      String?
  category         String?
  website          String?
  location         String?
  languages        String[]
  portfolioSummary String?
  socialLinks      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIFeature {
  AI_ASSISTANT
  POST_GENERATOR
  CONTENT_IDEAS
  MARKETING_PLANNER
  BUSINESS_ANALYSIS
}

model AIGeneration {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessProfileId String?
  feature           AIFeature
  inputJson         Json
  outputJson        Json
  createdAt         DateTime      @default(now())
  contentItems      ContentItem[]

  @@index([userId, feature, createdAt])
}

enum ContentStatus {
  IDEA
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
}

enum ContentSource {
  MANUAL
  AI_CONTENT_IDEA
  AI_POST_GENERATOR
}

model ContentItem {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessProfileId  String?
  title              String
  caption            String
  notes              String?
  platform           SocialPlatform
  contentType        String         @default("POST")
  status             ContentStatus  @default(IDEA)
  scheduledAt        DateTime?
  source             ContentSource  @default(MANUAL)
  sourceGenerationId String?
  sourceGeneration   AIGeneration?  @relation(fields: [sourceGenerationId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, scheduledAt])
  @@index([userId, status])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIUsage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AIFeature
  periodKey    String
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, feature, periodKey])
}

model AIUsageReservation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   AIFeature
  periodKey String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, feature, periodKey, expiresAt])
  @@index([expiresAt])
}

model BusinessProfile {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  industry                 String
  description              String?
  website                  String?
  locationMarket           String?
  productsServices         String?
  primaryOffer             String?
  targetAudience           String?
  audienceLocation         String?
  customerProblem          String?
  goals                    BusinessGoal[]
  brandTone                BrandTone?
  brandToneNotes           String?
  preferredContentLanguage String           @default("ka")
  brandValues              String?
  socialPlatforms          SocialPlatform[]
  competitors              Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerId       String
  customer         User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  providerUserId   String?
  providerUser     User?         @relation("ProviderOrders", fields: [providerUserId], references: [id], onDelete: SetNull)
  serviceId        String
  serviceSlug      String
  serviceTitleKa   String
  serviceTitleEn   String
  providerSlug     String
  providerName     String
  packageId        String
  packageNameKa    String
  packageNameEn    String
  priceMinor       Int
  currency         String        @default("GEL")
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  requirementsText String
  referenceLinks   Json?
  deliveryDate     DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  conversation     Conversation?

  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([providerUserId, status])
}

model Conversation {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerUserId String
  customer       User      @relation("ConversationCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  providerUserId String
  provider       User      @relation("ConversationProvider", fields: [providerUserId], references: [id], onDelete: Restrict)
  messages       Message[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerUserId, updatedAt])
  @@index([providerUserId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

/// Mutable business metadata for the code-owned marketplace catalog. The
/// immutable catalog id/source remain in code; administrators can only store
/// an explicit, validated presentation/status override here.
model CatalogServiceOverride {
  serviceId       String   @id
  titleKa         String
  titleEn         String
  descriptionKa   String
  descriptionEn   String
  category        String
  priceMinor      Int
  deliveryDays    Int
  status          String   @default("ACTIVE")
  packages        Json?
  updatedAt       DateTime @updatedAt
  updatedByUserId String
}
