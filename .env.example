# Copy this file to .env for local development. Never commit real secrets.

# PostgreSQL connection string. Railway supplies this from the PostgreSQL service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_step?schema=public"

# Required session-signing secret. Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional in local development. Studio AI requests return a safe configuration
# error when no key is supplied. Keep this server-only; never create a
# VITE_OPENAI_API_KEY variable.
OPENAI_API_KEY=""

# Optional shared model override. Defaults to gpt-5-mini and is used whenever a
# workload-specific override below is empty.
OPENAI_MODEL=""

# Optional workload-specific model overrides.
# AI Business Assistant
OPENAI_CHAT_MODEL=""
# Post Generator and Content Ideas
OPENAI_CONTENT_MODEL=""
# Marketing Planner and Business Analysis
OPENAI_ANALYSIS_MODEL=""

# Optional runtime settings. Railway injects PORT automatically.
PORT=3000
NODE_ENV="development"
